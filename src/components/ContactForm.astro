---
type Subject = 'aluno' | 'mentor' | 'parceria' | 'outro';

interface Props {
  subject?: Subject;
  messageLabel?: string;
  messagePlaceholder?: string;
  submitLabel?: string;
}

const {
  subject,
  messageLabel = 'Mensagem',
  messagePlaceholder = 'Sua mensagem',
  submitLabel = 'Enviar Mensagem',
} = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
---

<form data-contact-form data-subject={subject ?? ''} action="/api/contact" method="post" class="space-y-6">
  <div>
    <label class="block text-terminal-green font-mono mb-2" for="contact-name">Nome</label>
    <input
      type="text"
      id="contact-name"
      name="name"
      required
      minlength="2"
      maxlength="100"
      class="form-input"
      placeholder="Seu nome"
      autocomplete="name"
    />
  </div>

  <div>
    <label class="block text-terminal-green font-mono mb-2" for="contact-email">Email</label>
    <input
      type="email"
      id="contact-email"
      name="email"
      required
      maxlength="100"
      class="form-input"
      placeholder="seu@email.com"
      autocomplete="email"
    />
  </div>

  {subject ? (
    <input type="hidden" name="subject" value={subject} />
  ) : (
    <div>
      <label class="block text-terminal-green font-mono mb-2" for="contact-subject">Assunto</label>
      <select id="contact-subject" name="subject" required class="form-input">
        <option value="">Selecione um assunto</option>
        <option value="aluno">Quero ser aluno</option>
        <option value="mentor">Quero ser mentor</option>
        <option value="parceria">Proposta de parceria</option>
        <option value="outro">Outro assunto</option>
      </select>
    </div>
  )}

  <slot name="fields" />

  <div>
    <label class="block text-terminal-green font-mono mb-2" for="contact-message">{messageLabel}</label>
    <textarea
      id="contact-message"
      name="message"
      required
      minlength="10"
      maxlength="1000"
      class="form-input form-textarea"
      placeholder={messagePlaceholder}
    ></textarea>
  </div>

  <div class="cf-turnstile" data-sitekey={siteKey}></div>
  <div data-form-error class="text-red-500 hidden" role="alert"></div>
  <div data-form-success class="text-terminal-green hidden" role="status" aria-live="polite"></div>

  <button type="submit" class="button">{submitLabel}</button>
</form>

<script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>

<script>
interface TurnstileApi {
  getResponse(widget?: HTMLElement): string;
  reset(widget?: HTMLElement): void;
}

declare global {
  interface Window {
    turnstile?: TurnstileApi;
  }
}

document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
  const errorMessage = form.querySelector<HTMLElement>('[data-form-error]');
  const successMessage = form.querySelector<HTMLElement>('[data-form-success]');
  const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
  const widget = form.querySelector<HTMLElement>('.cf-turnstile');

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorMessage?.classList.add('hidden');
    successMessage?.classList.add('hidden');

    const turnstileToken = widget ? window.turnstile?.getResponse(widget) ?? '' : '';
    if (!turnstileToken) {
      if (errorMessage) {
        errorMessage.textContent = 'Conclua a verificação antirobô antes de enviar.';
        errorMessage.classList.remove('hidden');
      }
      return;
    }

    const formData = new FormData(form);
    const subjectValue = form.dataset.subject || String(formData.get('subject') ?? '');
    const message = String(formData.get('message') ?? '');
    const excludedFields = new Set(['name', 'email', 'subject', 'message']);
    const details: string[] = [];

    for (const element of Array.from(form.elements)) {
      if (!(element instanceof HTMLInputElement || element instanceof HTMLSelectElement || element instanceof HTMLTextAreaElement)) {
        continue;
      }
      if (!element.name || excludedFields.has(element.name) || element.disabled) {
        continue;
      }
      if ((element instanceof HTMLInputElement && ['hidden', 'submit', 'button', 'checkbox', 'radio'].includes(element.type))) {
        continue;
      }
      if ((element instanceof HTMLInputElement || element instanceof HTMLTextAreaElement) && !element.value.trim()) {
        continue;
      }
      if (element instanceof HTMLSelectElement && !element.value) {
        continue;
      }

      const label = element.labels?.[0]?.textContent?.trim() || element.name;
      details.push(`${label}: ${element.value.trim()}`);
    }

    const submitLabel = submitButton?.textContent?.trim() || 'Enviar';
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Enviando...';
    }

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: formData.get('name'),
          email: formData.get('email'),
          subject: subjectValue,
          message: [message, ...details].filter(Boolean).join('\n\n'),
          turnstileToken,
        }),
      });
      const result = await response.json() as { success?: boolean; message?: string; error?: string };

      if (!response.ok || !result.success) {
        throw new Error(result.error || 'Não foi possível enviar sua mensagem.');
      }

      form.reset();
      if (successMessage) {
        successMessage.textContent = result.message || 'Mensagem enviada com sucesso.';
        successMessage.classList.remove('hidden');
      }
    } catch (error) {
      if (errorMessage) {
        errorMessage.textContent = error instanceof Error ? error.message : 'Não foi possível enviar sua mensagem.';
        errorMessage.classList.remove('hidden');
      }
    } finally {
      if (widget) {
        window.turnstile?.reset(widget);
      }
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = submitLabel;
      }
    }
  });
});
</script>
