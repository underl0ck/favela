---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import ContactForm from '../components/ContactForm.astro';
import { Image } from 'astro:assets';

const benefits = [
  'Curso gratuito de 6 meses',
  'Mentoria personalizada',
  'Projetos práticos',
  'Networking com profissionais',
  'Preparação para certificações',
  'Oportunidades de emprego',
];

const requirements = [
  'Idade mínima: 16 anos',
  'Acesso à internet',
  'Comprometimento com os estudos',
  'Disponibilidade de 15h semanais',
  'Interesse por tecnologia',
  'Residir em comunidade',
];

const process = [
  {
    step: '1',
    title: 'Inscrição',
    description: 'Preencha o formulário de interesse',
  },
  {
    step: '2',
    title: 'Seleção',
    description: 'Processo seletivo com teste básico e entrevista',
  },
  {
    step: '3',
    title: 'Início',
    description: 'Começo das aulas na próxima turma',
  },
];
---

<Layout
  title="Inscreva-se - Favela Hacker"
  description="Faça parte da próxima geração de profissionais em cibersegurança"
>
  <div class="max-w-4xl mx-auto">
    <Image
      src="https://images.pexels.com/photos/5896659/pexels-photo-5896659.jpeg"
      alt="Estudantes do Favela Hacker aprendendo tecnologia"
      width={1200}
      height={600}
      class="w-full h-64 object-cover rounded-lg mb-8"
      loading="eager"
      decoding="sync"
    />

    <h1 class="text-4xl font-mono text-terminal-green mb-8">Quero Aprender</h1>

    <div class="grid md:grid-cols-2 gap-8 mb-12">
      <Card title="Benefícios">
        <ul class="space-y-2">
          {benefits.map((benefit) => (
            <li>• {benefit}</li>
          ))}
        </ul>
      </Card>

      <Card title="Requisitos">
        <ul class="space-y-2">
          {requirements.map((requirement) => (
            <li>• {requirement}</li>
          ))}
        </ul>
      </Card>
    </div>

    <section class="mb-12">
      <h2 class="text-2xl font-mono text-terminal-green mb-6">Processo Seletivo</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {process.map(({ step, title, description }) => (
          <Card title={`${step}. ${title}`}>
            <p>{description}</p>
          </Card>
        ))}
      </div>
    </section>

    <Card title="Inscreva-se" className="mb-12">
      <ContactForm
        subject="aluno"
        messageLabel="Por que você quer participar do programa?"
        messagePlaceholder="Conte-nos sua motivação"
        submitLabel="Enviar Inscrição"
      >
        <div slot="fields" class="space-y-6">
          <div>
            <label class="block text-terminal-green font-mono mb-2" for="enrollment-age">Idade</label>
            <input
              type="number"
              id="enrollment-age"
              name="age"
              required
              min="16"
              max="100"
              class="form-input"
              autocomplete="off"
            />
          </div>

          <div>
            <label class="block text-terminal-green font-mono mb-2" for="enrollment-community">
              Comunidade onde reside
            </label>
            <input
              type="text"
              id="enrollment-community"
              name="community"
              required
              minlength="2"
              maxlength="100"
              class="form-input"
              placeholder="Nome da sua comunidade"
              autocomplete="address-level2"
            />
          </div>
        </div>
      </ContactForm>
    </Card>

    <div class="text-center">
      <p class="text-lg mb-4">Tem alguma dúvida?</p>
      <a
        href="/contato"
        class="button bg-transparent border-2 border-terminal-green text-terminal-green hover:bg-terminal-green hover:text-terminal-bg"
      >
        Entre em Contato
      </a>
    </div>
  </div>
</Layout>
