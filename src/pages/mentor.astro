---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import ContactForm from '../components/ContactForm.astro';
import { Image } from 'astro:assets';

const responsibilities = [
  'Mentorar alunos semanalmente',
  'Compartilhar experiências práticas',
  'Ajudar no desenvolvimento técnico',
  'Orientar sobre carreira',
  'Participar de workshops',
];

const requirements = [
  'Experiência em cibersegurança',
  'Disponibilidade de 4h semanais',
  'Comprometimento mínimo de 6 meses',
  'Boa comunicação',
  'Vontade de ensinar',
];

const benefits = [
  'Impacto social direto',
  'Networking com outros mentores',
  'Desenvolvimento de liderança',
  'Reconhecimento da comunidade',
  'Certificado de mentoria',
];
---

<Layout
  title="Seja Mentor - Favela Hacker"
  description="Compartilhe seu conhecimento e transforme vidas através da mentoria"
>
  <div class="max-w-4xl mx-auto">
    <Image
      src="https://images.pexels.com/photos/5896659/pexels-photo-5896659.jpeg"
      alt="Mentoria em tecnologia"
      width={1200}
      height={600}
      class="w-full h-96 object-cover rounded-lg mb-8"
      loading="eager"
      decoding="sync"
    />

    <h1 class="text-4xl font-mono text-terminal-green mb-8">Quero Ensinar</h1>

    <div class="grid md:grid-cols-3 gap-8 mb-12">
      <Card title="O que você fará">
        <ul class="space-y-2">
          {responsibilities.map((item) => (
            <li>• {item}</li>
          ))}
        </ul>
      </Card>

      <Card title="O que precisamos">
        <ul class="space-y-2">
          {requirements.map((item) => (
            <li>• {item}</li>
          ))}
        </ul>
      </Card>

      <Card title="O que oferecemos">
        <ul class="space-y-2">
          {benefits.map((item) => (
            <li>• {item}</li>
          ))}
        </ul>
      </Card>
    </div>

    <Card title="Candidate-se" className="mb-12">
      <ContactForm
        subject="mentor"
        messageLabel="Por que você quer ser mentor?"
        messagePlaceholder="Conte-nos sua motivação"
        submitLabel="Enviar Candidatura"
      >
        <div slot="fields" class="space-y-6">
          <div>
            <label class="block text-terminal-green font-mono mb-2" for="mentor-expertise">
              Área de Expertise
            </label>
            <select id="mentor-expertise" name="expertise" required class="form-input">
              <option value="">Selecione sua área</option>
              <option value="pentest">Pentest</option>
              <option value="forense">Forense Digital</option>
              <option value="malware">Análise de Malware</option>
              <option value="cloud">Segurança em Cloud</option>
              <option value="appsec">Segurança de Aplicações</option>
              <option value="outro">Outro</option>
            </select>
          </div>

          <div>
            <label class="block text-terminal-green font-mono mb-2" for="mentor-experience">
              Anos de Experiência
            </label>
            <input
              type="number"
              id="mentor-experience"
              name="experience"
              required
              min="1"
              max="50"
              class="form-input"
            />
          </div>
        </div>
      </ContactForm>
    </Card>

    <div class="text-center">
      <p class="text-lg mb-4">Tem alguma dúvida?</p>
      <a
        href="/contato"
        class="button bg-transparent border-2 border-terminal-green text-terminal-green hover:bg-terminal-green hover:text-terminal-bg"
      >
        Entre em Contato
      </a>
    </div>
  </div>
</Layout>
